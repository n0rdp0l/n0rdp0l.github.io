---
import { ViewTransitions } from 'astro:transitions';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Iceberg from '../components/Iceberg.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <ThemeInit />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <ViewTransitions />
</head>
<body class="n0-root">
  <Iceberg />
  <ThemeToggle />
  <MobileMenu />
  <div class="n0-frame n0-frame--bleed">
    <slot />
  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
