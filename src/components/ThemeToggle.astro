---
// Wired up by ThemeInit.astro.
---

<button id="theme-toggle" class="n0-toggle theme-toggle" aria-label="Toggle dark mode">
  <span class="sun">☀</span>
  <span class="moon">☾</span>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: var(--space-6);
    right: var(--space-6);
    z-index: 1000;
  }

  .sun,
  .moon {
    position: absolute;
    transition: opacity 0.3s, transform 0.3s;
  }

  [data-theme="paper"] .sun {
    opacity: 1;
    transform: rotate(0deg);
  }

  [data-theme="paper"] .moon {
    opacity: 0;
    transform: rotate(180deg);
  }

  [data-theme="crt"] .sun {
    opacity: 0;
    transform: rotate(-180deg);
  }

  [data-theme="crt"] .moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  @media (max-width: 800px) {
    .theme-toggle {
      top: var(--space-4);
      right: var(--space-4);
      width: 45px;
      height: 45px;
      font-size: 20px;
    }
  }
</style>
