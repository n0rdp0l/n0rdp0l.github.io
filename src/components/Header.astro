---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  transitionName?: string;
}

const {
  title = 'n0rdp0l',
  subtitle = '',
  description = '',
  transitionName,
} = Astro.props;
---

<div class="n0-band">
  <h1 transition:name={transitionName}>{title}</h1>
  {subtitle && <h2>{subtitle}</h2>}
  {description && <p>{description}</p>}
</div>
