---
// The strip under the band. Home drops its own link; every other page
// leads with it. The section the page belongs to is marked current.
const path = Astro.url.pathname;
const isHome = path === '/';
const section = (prefixes: string[]) =>
  prefixes.some((p) => path.startsWith(p)) ? 'page' : undefined;
---

<nav class="n0-strip">
  {!isHome && <a href="/">Home</a>}
  <a href="/blog/" aria-current={section(['/blog/', '/tags/', '/archives/'])}>Blog</a>
  <a href="/cv/" aria-current={section(['/cv/'])}>Curriculum Vitae</a>
  <a href="/about/" aria-current={section(['/about/'])}>Contact</a>
</nav>
